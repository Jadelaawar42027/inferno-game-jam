[sub_resource type="Resource" id="Resource_njm3d"]
script = ExtResource("4_j5jpt")
SPEAKER = 1
TEXT = "Tell me, how does it feel to absorb a new authority? Name your price mortal, I'll give you anything you desire in exchange for it."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_8glaw"]
script = ExtResource("4_j5jpt")
TEXT = "What I desire lies on the other side of your corpse. Surrender, and I'll make this an easy death for you"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_aq8lw"]
script = ExtResource("4_j5jpt")
SPEAKER = 1
TEXT = "How disappointing... Then I'll simply take it from you mortal"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_wdyfh"]
script = ExtResource("4_j5jpt")
SPEAKER = 1
TEXT = "You want what no man has had, or can ever have. And I'm the greedy one?"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_23gyv"]
script = ExtResource("4_j5jpt")
SPEAKER = 1
TEXT = "You possess two authorities now. You're getting closer."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

