[sub_resource type="Resource" id="Resource_pyic4"]
script = ExtResource("2_frp0q")
SPEAKER = 1
TEXT = "Further down. You’ll need to make your way down each LAYER"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_h08c8"]
script = ExtResource("2_frp0q")
SPEAKER = 1
TEXT = "You must defeat each sin and absorb its authority. Its authority will unlock the passage to the next layer."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_fcqgi"]
script = ExtResource("2_frp0q")
TEXT = "How do I absorb an authority?"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_wp7x2"]
script = ExtResource("2_frp0q")
SPEAKER = 1
TEXT = "After defeating a sin, use this spell, ‘Vinculum Aeternum’ to attune their authority to you."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_t25vn"]
script = ExtResource("2_frp0q")
TEXT = "I see. I’ll get going then."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_jawte"]
