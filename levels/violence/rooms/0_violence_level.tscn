[node name="SecretMessages" type="Node2D" parent="." unique_id=1748822044]

[node name="SecretMessage1" parent="SecretMessages" unique_id=699890953 instance=ExtResource("912_hub")]
position = Vector2(4247.2, 902)
text = "The trees here were men who chose the blade.
They bleed when you break them."
font_size = 8

[node name="SecretMessage2" parent="SecretMessages" unique_id=1518849672 instance=ExtResource("912_hub")]
position = Vector2(5332, 262)
text = "They loosed ten thousand arrows at the beast.
It kept every one."
font_size = 8

[node name="SecretMessage3" parent="SecretMessages" unique_id=1187741353 instance=ExtResource("912_hub")]
position = Vector2(336.8, 902)
text = "Every horn on this wall was a challenger.
The Butcher keeps the ones who ran."
font_size = 8

[node name="SecretMessage4" parent="SecretMessages" unique_id=202837740 instance=ExtResource("912_hub")]
position = Vector2(4036, 1414)
text = "He was a man before the maze.
He only remembers the cutting."
font_size = 8

[node name="SecretMessage5" parent="SecretMessages" unique_id=37752170 instance=ExtResource("912_hub")]
position = Vector2(3972, 1606)
text = "Follow the red thread, little knight.
It only ever leads one way."
font_size = 8

