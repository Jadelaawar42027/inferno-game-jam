[sub_resource type="Resource" id="DL_cow77"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "My child, you have done well to come this far. I was right in choosing you"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_u2sa1"]
script = ExtResource("33_dl")
TEXT = "Virgil? What's going on, and where is she?"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_xjek1"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "Your desperation and delusion caused you to cling onto the slightest hope you could bring her back, leading you to me. You believed your own daughter belonged in hell... How sad."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_vd0fi"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "Fortunately for me, it was the only door I needed to make you trust me, and to make you step into that magic circle with me."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_wgy1t"]
script = ExtResource("33_dl")
TEXT = "What's the meaning of this!?!?!"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_dlsab"]
script = ExtResource("33_dl")
TEXT = "WHERE THE HELL IS SHE VIRGIL?????"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_y44sf"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "Don't you understand? She was never in hell. Her soul passed on long ago. Not even the ancient magic you sought could bring her back"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_neb6q"]
script = ExtResource("33_dl")
TEXT = "N-no..."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_2w6a7"]
script = ExtResource("33_dl")
TEXT = "A feeling of weakness spreads through my body... I feel dizzy. Disoriented. My legs give out. I stare in shock"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_sr0fl"]
script = ExtResource("33_dl")
TEXT = "I remember the day I couldn't save her. Her smile. Her sobs. Her last words to me. Something nefarious is bubbling inside me. I glare at Virgil with soul-less eyes"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_5nb5l"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "You see, before I was sealed by the Last Archangel, I split a fragment of my soul, cut loose from hell and sent into the living world"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_0aow8"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "My seals could only be fractured by a mortal soul, carrying every sin, so I couldn't use my alibi to set me free. For years, this piece of my consciousness was tasked with leading capable and trusting mortals into hell, in an attempt to free me."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_r65xx"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "But oh how I underestimated the task. They were all too weak. Until I laid my eyes on you…"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_08mn4"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "Containing ancient knowledge, Virgil. No, I… became known as the ArchMagus, building my reputation as the sage who was rumored to  have the ability to tether lost souls back into reality"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_63kq0"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "No chains hold a man like the thing he longs for.."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_m62pw"]
script = ExtResource("33_dl")
TEXT = "You... I will devour you. I will own you. I will annihilate you. I will wear your face. And for your betrayal, I will take your place... I'll show you a true devil.."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="DL_i34sg"]
script = ExtResource("33_dl")
SPEAKER = 1
TEXT = "I'd love to see you try"
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_pfgta"]
script = ExtResource("33_dl")
TEXT = "Hell is being let loose… I know what I must do."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

[sub_resource type="Resource" id="Resource_1wrdp"]
script = ExtResource("33_dl")
TEXT = "Goodbye, daughter."
metadata/_custom_type_script = "uid://dkj0fvj30brcg"

