[node name="SecretMessages" type="Node2D" parent="."]

[node name="SecretMessage1" parent="SecretMessages" instance=ExtResource("911_hub")]
position = Vector2(1956, 262)
text = "He told them everything they wanted to hear.
That was the whole trick."
font_size = 8

[node name="SecretMessage2" parent="SecretMessages" instance=ExtResource("911_hub")]
position = Vector2(215.2, 774)
text = "A thousand faces hang here.
Not one of them was ever his own."
font_size = 8

[node name="SecretMessage3" parent="SecretMessages" instance=ExtResource("911_hub")]
position = Vector2(6352.8, 774)
text = "Every flower in this garden is painted.
Only the thorns are real."
font_size = 8

[node name="SecretMessage4" parent="SecretMessages" instance=ExtResource("911_hub")]
position = Vector2(1108, 1286)
text = "They danced until the masks grew in.
Now no one remembers who asked them to."
font_size = 8

[node name="SecretMessage5" parent="SecretMessages" instance=ExtResource("911_hub")]
position = Vector2(3844, 1734)
text = "Kneel if you like, little knight.
No one has ever been listening."
font_size = 8

