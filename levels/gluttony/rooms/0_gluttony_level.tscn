[node name="SecretMessages" type="Node2D" parent="." unique_id=363974200]

[node name="SecretMessage1" parent="SecretMessages" unique_id=281832823 instance=ExtResource("912_hub")]
position = Vector2(804, 1382)
text = "The cellar keeps what the kitchen forgot.
Nothing down here was ever served."
font_size = 8

[node name="SecretMessage2" parent="SecretMessages" unique_id=245236215 instance=ExtResource("912_hub")]
position = Vector2(1988, 870)
text = "They ate until the walls ate them.
The rats are all that is left of the cooks."
font_size = 8

[node name="SecretMessage3" parent="SecretMessages" unique_id=221459373 instance=ExtResource("912_hub")]
position = Vector2(6276, 1030)
text = "Every spice in the tower was a prayer once.
Gluttony only kept the taste."
font_size = 8

[node name="SecretMessage4" parent="SecretMessages" unique_id=259956112 instance=ExtResource("912_hub")]
position = Vector2(7319.2, 294)
text = "The ovens never cooled.
Someone is still waiting for bread that will never be enough."
font_size = 8

[node name="SecretMessage5" parent="SecretMessages" unique_id=598033181 instance=ExtResource("912_hub")]
position = Vector2(3972, 1382)
text = "Wash your hands, little knight.
Nothing here ever comes clean."
font_size = 8

[node name="SecretMessage6" parent="SecretMessages" unique_id=169464395 instance=ExtResource("912_hub")]
position = Vector2(3028, 1606)
text = "A place was set for you.
It has been set for a very long time."
font_size = 8

