[node name="SecretMessage1" parent="SecretMessages" instance=ExtResource("912_hub")]
position = Vector2(5140, 262)
text = "Every soul owed him something.
He wrote it all down and forgave nothing."
font_size = 8

[node name="SecretMessage2" parent="SecretMessages" instance=ExtResource("912_hub")]
position = Vector2(237.6, 902)
text = "He hid the first coin he ever stole.
It was the only one he ever loved."
font_size = 8

[node name="SecretMessage3" parent="SecretMessages" instance=ExtResource("912_hub")]
position = Vector2(4436, 902)
text = "Each safe holds a promise he made.
