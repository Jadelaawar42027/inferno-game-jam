[node name="SecretMessage1" parent="SecretMessages" unique_id=1604380827 instance=ExtResource("912_hub")]
position = Vector2(5140, 262)
text = "Every soul owed him something.
He wrote it all down and forgave nothing."
font_size = 8

[node name="SecretMessage2" parent="SecretMessages" unique_id=1166672172 instance=ExtResource("912_hub")]
position = Vector2(237.6, 902)
text = "He hid the first coin he ever stole.
It was the only one he ever loved."
font_size = 8

[node name="SecretMessage3" parent="SecretMessages" unique_id=289023354 instance=ExtResource("912_hub")]
position = Vector2(4436, 902)
text = "Each safe holds a promise he made.
Not one of them was ever opened again."
font_size = 8

[node name="SecretMessage4" parent="SecretMessages" unique_id=1831472503 instance=ExtResource("912_hub")]
position = Vector2(596, 1606)
text = "The thieves dug down to rob a king.
The gold kept them instead."
font_size = 8

[node name="SecretMessage5" parent="SecretMessages" unique_id=40871346 instance=ExtResource("912_hub")]
position = Vector2(3716, 1606)
text = "Kneel, little knight.
Everything that touches the King becomes his."
font_size = 8

