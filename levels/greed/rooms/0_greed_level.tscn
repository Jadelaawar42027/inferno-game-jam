The gold kept them instead."
font_size = 8

[node name="SecretMessage5" parent="SecretMessages" instance=ExtResource("912_hub")]
position = Vector2(3716, 1606)
text = "Kneel, little knight.
Everything that touches the King becomes his."
font_size = 8

